node_modules/
dist/
build/
*.tsbuildinfo

# Runtime data — the SQLite database lives beside the executable at runtime
data/
.test-data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Local env / secrets (projector admin passwords)
.env
.env.local

# Packaging output (phase 7)
release/

# OS noise
.DS_Store
Thumbs.db

# Vite build-time temp file (ESM config interop), not meant to persist
vite.config.ts.timestamp-*.mjs

# Claude Code — personal/machine-specific tool permissions, not shared
.claude/settings.local.json

# Vendored Tesseract.js WASM/language-data assets (~22MB) — regenerated by
# `npm run setup:ocr-assets`, not source; see scripts/setup-ocr-assets.mjs.
packages/frontend/public/tesseract/

# Vendored js-dos player + DOOM1.WAD shareware IWAD (~25MB), for the About
# page easter egg — regenerated by `npm run setup:doom-assets`, not source;
# see scripts/setup-doom-assets.mjs.
packages/frontend/public/doom-engine/

# Mirrored into packages/frontend/public/ on every dev/build by
# scripts/copy-static-docs.mjs — docs/UserGuide.md and LICENSE (root) are
# the actual sources of truth, not these copies.
packages/frontend/public/UserGuide.md
packages/frontend/public/LICENSE.txt

# Large reference PDFs, purged from git history (2026-07-30) to keep the
# repo small — kept here locally, untracked, for reference only.
_old/*.pdf
