{
  "name": "panasonic-multi-controller",
  "version": "0.1.0",
  "private": true,
  "description": "Centralised monitoring and control for a fleet of Panasonic projectors over NTCONTROL (TCP/1024).",
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/frontend"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "npm run build --workspace @ppc/shared && npm run build --workspace @ppc/frontend && npm run build --workspace @ppc/backend",
    "dev": "npm run dev --workspace @ppc/backend",
    "dev:web": "npm run dev --workspace @ppc/frontend",
    "migrate": "npm run migrate --workspace @ppc/backend",
    "seed": "npm run seed --workspace @ppc/backend",
    "typecheck": "tsc -b && tsc --noEmit -p packages/frontend/tsconfig.json",
    "clean": "node -e \"for (const p of ['shared','backend','frontend']) require('fs').rmSync('packages/'+p+'/dist',{recursive:true,force:true})\"",
    "package:win": "node scripts/package.mjs win"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.6.3"
  }
}
